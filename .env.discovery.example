# Generate each secret independently, e.g. openssl rand -hex 32
CATALOG_ADMIN_KEY=
CRON_SECRET=
# Required for production: persistent writable volume, not /tmp or the public folder.
CATALOG_DATA_DIR=
APP_PUBLIC_URL=https://rivelolabs.com
# Optional public Google Play metadata provider
SERPAPI_API_KEY=
# Owner invitation delivery. Configure a verified sender and real business address.
OUTREACH_ENABLED=false
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=
OUTREACH_SENDER_ADDRESS=
# Optional map tile provider (visible attribution must match provider requirements).
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Persistent Supabase/PostgreSQL catalog. Initialize before switching storage.
CATALOG_STORE=file
DATABASE_URL=
DATABASE_CA_PATH=certs/supabase-ca.crt
# Alternative to a certificate file, with literal \\n escapes allowed:
DATABASE_CA_CERT=
# Google/X authentication; these two values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Billing (Razorpay) ── create two monthly USD plans in Razorpay Dashboard → Subscriptions → Plans
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_SPOTLIGHT=   # plan_... for $10/month
RAZORPAY_PLAN_GROWTH=      # plan_... for $20/month
RAZORPAY_PLAN_YACHT=       # plan_... for the map yacht (monthly, must match YACHT_PRICE in src/lib/yachts.ts)

# ── Launches ── Product Hunt developer token
PRODUCTHUNT_TOKEN=

# ── Google sign-in on our own domain
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── X maker pages ── X API v2 bearer token (Basic plan or higher, for recent search)
X_BEARER_TOKEN=
